      <set_append_logfile>N</set_append_logfile><set_logfile>N</set_logfile><wait_until_finished>Y</wait_until_finished>
      <parallel>N</parallel><xloc>944</xloc><yloc>128</yloc><attributes_hac/>
    </action>
    <action>
      <name>04_dim_pais</name>
