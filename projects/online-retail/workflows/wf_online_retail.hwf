      <add_date>N</add_date><add_time>N</add_time>
      <clear_files>N</clear_files><clear_rows>N</clear_rows>
      <create_parent_folder>N</create_parent_folder>
      <exec_per_row>N</exec_per_row>
      <filename>${PROJECT_HOME}/pipelines/01_ingestao_online_retail.hpl</filename>
