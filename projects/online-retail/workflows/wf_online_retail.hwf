<?xml version="1.0" encoding="UTF-8"?>
<workflow>
  <name>wf_online_retail</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description>Orquestra a carga Online Retail do início auditado até os indicadores.</description>
  <extended_description>Todos os pipelines executam localmente e recebem os parâmetros do workflow. Cada saída de erro converge para 99_marcar_falha.</extended_description>
  <workflow_version/>
  <created_user>Codex</created_user>
  <created_date>2026/08/25 00:00:00.000</created_date>
  <modified_user>Codex</modified_user>
  <modified_date>2026/08/25 00:00:00.000</modified_date>
  <parameters>
    <parameter>
      <name>ONLINE_RETAIL_FILE</name>
      <default_value>${PROJECT_HOME}/data/online_retail.xlsx</default_value>
      <description>Arquivo Excel Online Retail a processar.</description>
    </parameter>
  </parameters>
  <actions>
    <action>
      <name>START</name>
      <description/>
      <type>SPECIAL</type>
      <attributes/>
      <DayOfMonth>1</DayOfMonth>
      <hour>12</hour>
      <intervalMinutes>60</intervalMinutes>
      <intervalSeconds>0</intervalSeconds>
      <minutes>0</minutes>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <weekDay>1</weekDay>
      <parallel>N</parallel>
      <xloc>64</xloc>
      <yloc>128</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>00_inicializar_batch</name>
      <description>Inicializa o lote, limpa a staging e registra RUNNING.</description>
      <type>PIPELINE</type>
      <attributes/>
      <add_date>N</add_date><add_time>N</add_time>
      <clear_files>N</clear_files><clear_rows>N</clear_rows>
      <create_parent_folder>N</create_parent_folder>
      <exec_per_row>N</exec_per_row>
      <filename>${PROJECT_HOME}/pipelines/00_inicializar_batch.hpl</filename>
      <logext/><logfile/><loglevel>Basic</loglevel>
      <parameters><pass_all_parameters>Y</pass_all_parameters></parameters>
      <params_from_previous>N</params_from_previous>
      <run_configuration>local</run_configuration>
      <set_append_logfile>N</set_append_logfile><set_logfile>N</set_logfile>
      <wait_until_finished>Y</wait_until_finished>
      <parallel>N</parallel>
      <xloc>256</xloc><yloc>128</yloc><attributes_hac/>
    </action>
    <action>
      <name>01_ingestao_online_retail</name>
      <description>Lê a fonte e persiste a staging textual.</description>
      <type>PIPELINE</type>
