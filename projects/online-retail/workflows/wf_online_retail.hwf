      <set_append_logfile>N</set_append_logfile><set_logfile>N</set_logfile>
      <wait_until_finished>Y</wait_until_finished>
      <parallel>N</parallel>
      <xloc>480</xloc><yloc>128</yloc><attributes_hac/>
    </action>
    <action>
      <name>02_tratamento_online_retail</name>
      <description>Converte, valida, deduplica e separa válidos/rejeitados.</description>
      <type>PIPELINE</type>
