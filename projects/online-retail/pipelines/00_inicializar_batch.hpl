<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>00_inicializar_batch</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Gera o identificador da execucao, publica BATCH_ID no workflow pai e registra o lote como RUNNING.</description>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <parameters/>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>Codex</created_user>
    <created_date>2026/08/25 00:00:00.000</created_date>
    <modified_user>Codex</modified_user>
    <modified_date>2026/08/25 00:00:00.000</modified_date>
  </info>
  <notepads/>
  <order>
    <hop>
      <from>Gerar batch</from>
      <to>Definir BATCH_ID</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Definir BATCH_ID</from>
      <to>Registrar execucao RUNNING</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>Gerar batch</name>
    <type>TableInput</type>
    <description>O UUID e gerado pelo PostgreSQL, garantindo um lote novo por execucao.</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>OnlineRetailPostgreSQL</connection>
    <sql>SELECT
  gen_random_uuid()::text AS batch_id,
  CURRENT_TIMESTAMP AS inicio_execucao,
  'RUNNING'::varchar(16) AS status,
  '${ONLINE_RETAIL_FILE}'::text AS arquivo_origem</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>Y</variables_active>
    <attributes/>
    <GUI>
      <xloc>96</xloc>
      <yloc>128</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Definir BATCH_ID</name>
    <type>SetVariable</type>
    <description>Disponibiliza BATCH_ID para as proximas actions do workflow principal.</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <fields>
      <field>
        <field_name>batch_id</field_name>
        <variable_name>BATCH_ID</variable_name>
        <variable_type>PARENT_WORKFLOW</variable_type>
      </field>
    </fields>
    <use_formatting>Y</use_formatting>
    <attributes/>
    <GUI>
      <xloc>304</xloc>
      <yloc>128</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Registrar execucao RUNNING</name>
    <type>TableOutput</type>
    <description>Insere a linha inicial em online_retail.log_execucao.</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <commit>1</commit>
    <connection>OnlineRetailPostgreSQL</connection>
    <schema>online_retail</schema>
    <table>log_execucao</table>
    <truncate>N</truncate>
    <ignore_errors>N</ignore_errors>
    <use_batch>N</use_batch>
    <specify_fields>Y</specify_fields>
    <partitioning_enabled>N</partitioning_enabled>
    <partitioning_daily>N</partitioning_daily>
    <partitioning_monthly>N</partitioning_monthly>
    <tablename_in_field>N</tablename_in_field>
    <tablename_in_table>Y</tablename_in_table>
    <return_keys>N</return_keys>
    <fields>
      <field><column_name>batch_id</column_name><stream_name>batch_id</stream_name></field>
      <field><column_name>inicio_execucao</column_name><stream_name>inicio_execucao</stream_name></field>
      <field><column_name>status</column_name><stream_name>status</stream_name></field>
      <field><column_name>arquivo_origem</column_name><stream_name>arquivo_origem</stream_name></field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>528</xloc>
      <yloc>128</yloc>
    </GUI>
  </transform>
  <transform_error_handling/>
  <attributes/>
</pipeline>
