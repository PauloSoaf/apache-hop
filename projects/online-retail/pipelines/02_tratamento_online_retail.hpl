<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>02_tratamento_online_retail</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Converte tipos, elimina duplicatas integrais, aplica regras de qualidade e separa validos de rejeitados.</description>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <parameters/>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>Codex</created_user>
    <created_date>2026/08/25 00:00:00.000</created_date>
    <modified_user>Codex</modified_user>
    <modified_date>2026/08/25 00:00:00.000</modified_date>
  </info>
  <notepads/>
  <order>
    <hop><from>Ler staging</from><to>Aplicar trim</to><enabled>Y</enabled></hop>
    <hop><from>Aplicar trim</from><to>Converter tipos</to><enabled>Y</enabled></hop>
    <hop><from>Converter tipos</from><to>Ordenar para deduplicacao</to><enabled>Y</enabled></hop>
    <hop><from>Converter tipos</from><to>Marcar erro de conversao</to><enabled>Y</enabled></hop>
    <hop><from>Marcar erro de conversao</from><to>Gravar rejeitados de conversao</to><enabled>Y</enabled></hop>
    <hop><from>Ordenar para deduplicacao</from><to>Remover duplicatas integrais</to><enabled>Y</enabled></hop>
    <hop><from>Remover duplicatas integrais</from><to>Aplicar regras de negocio</to><enabled>Y</enabled></hop>
    <hop><from>Remover duplicatas integrais</from><to>Marcar duplicata</to><enabled>Y</enabled></hop>
    <hop><from>Marcar duplicata</from><to>Gravar duplicatas rejeitadas</to><enabled>Y</enabled></hop>
    <hop><from>Aplicar regras de negocio</from><to>Separar validos e invalidos</to><enabled>Y</enabled></hop>
    <hop><from>Separar validos e invalidos</from><to>Calcular valor total</to><enabled>Y</enabled></hop>
    <hop><from>Calcular valor total</from><to>Gravar validos</to><enabled>Y</enabled></hop>
    <hop><from>Separar validos e invalidos</from><to>Gravar rejeitados por regra</to><enabled>Y</enabled></hop>
  </order>
  <transform>
    <name>Ler staging</name>
    <type>TableInput</type>
    <description>Duplica somente os campos que serao tipados; os campos originais permanecem disponiveis para auditoria.</description>
    <distribute>Y</distribute><custom_distribution/><copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <connection>OnlineRetailPostgreSQL</connection>
    <sql>SELECT
  batch_id,
  linha_seq,
  invoice_no,
  stock_code,
  description,
  quantity_original,
  invoice_date_original,
  unit_price_original,
  customer_id_original,
  country_original,
  quantity_original AS quantity,
  invoice_date_original AS invoice_date,
  unit_price_original AS unit_price,
  NULLIF(customer_id_original, '') AS customer_id,
  country_original AS country,
  registro_hash
FROM online_retail.stg_online_retail
WHERE batch_id = '${BATCH_ID}'
ORDER BY linha_seq</sql>
    <limit>0</limit><lookup/><execute_each_row>N</execute_each_row><variables_active>Y</variables_active>
    <attributes/>
    <GUI><xloc>64</xloc><yloc>240</yloc></GUI>
  </transform>
  <transform>
    <name>Aplicar trim</name>
    <type>StringOperations</type>
    <description>Remove somente espacos externos dos campos textuais brutos e das copias destinadas a conversao.</description>
    <distribute>Y</distribute><custom_distribution/><copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <fields>
      <field><in_stream_name>invoice_no</in_stream_name><out_stream_name/><trim_type>both</trim_type><lower_upper>none</lower_upper><padding_type>none</padding_type><pad_char/><pad_len/><init_cap>no</init_cap><mask_xml>none</mask_xml><digits>none</digits><remove_special_characters>none</remove_special_characters></field>
      <field><in_stream_name>stock_code</in_stream_name><out_stream_name/><trim_type>both</trim_type><lower_upper>none</lower_upper><padding_type>none</padding_type><pad_char/><pad_len/><init_cap>no</init_cap><mask_xml>none</mask_xml><digits>none</digits><remove_special_characters>none</remove_special_characters></field>
      <field><in_stream_name>description</in_stream_name><out_stream_name/><trim_type>both</trim_type><lower_upper>none</lower_upper><padding_type>none</padding_type><pad_char/><pad_len/><init_cap>no</init_cap><mask_xml>none</mask_xml><digits>none</digits><remove_special_characters>none</remove_special_characters></field>
      <field><in_stream_name>quantity_original</in_stream_name><out_stream_name/><trim_type>both</trim_type><lower_upper>none</lower_upper><padding_type>none</padding_type><pad_char/><pad_len/><init_cap>no</init_cap><mask_xml>none</mask_xml><digits>none</digits><remove_special_characters>none</remove_special_characters></field>
      <field><in_stream_name>invoice_date_original</in_stream_name><out_stream_name/><trim_type>both</trim_type><lower_upper>none</lower_upper><padding_type>none</padding_type><pad_char/><pad_len/><init_cap>no</init_cap><mask_xml>none</mask_xml><digits>none</digits><remove_special_characters>none</remove_special_characters></field>
      <field><in_stream_name>unit_price_original</in_stream_name><out_stream_name/><trim_type>both</trim_type><lower_upper>none</lower_upper><padding_type>none</padding_type><pad_char/><pad_len/><init_cap>no</init_cap><mask_xml>none</mask_xml><digits>none</digits><remove_special_characters>none</remove_special_characters></field>
      <field><in_stream_name>customer_id_original</in_stream_name><out_stream_name/><trim_type>both</trim_type><lower_upper>none</lower_upper><padding_type>none</padding_type><pad_char/><pad_len/><init_cap>no</init_cap><mask_xml>none</mask_xml><digits>none</digits><remove_special_characters>none</remove_special_characters></field>
      <field><in_stream_name>country_original</in_stream_name><out_stream_name/><trim_type>both</trim_type><lower_upper>none</lower_upper><padding_type>none</padding_type><pad_char/><pad_len/><init_cap>no</init_cap><mask_xml>none</mask_xml><digits>none</digits><remove_special_characters>none</remove_special_characters></field>
      <field><in_stream_name>quantity</in_stream_name><out_stream_name/><trim_type>both</trim_type><lower_upper>none</lower_upper><padding_type>none</padding_type><pad_char/><pad_len/><init_cap>no</init_cap><mask_xml>none</mask_xml><digits>none</digits><remove_special_characters>none</remove_special_characters></field>
      <field><in_stream_name>invoice_date</in_stream_name><out_stream_name/><trim_type>both</trim_type><lower_upper>none</lower_upper><padding_type>none</padding_type><pad_char/><pad_len/><init_cap>no</init_cap><mask_xml>none</mask_xml><digits>none</digits><remove_special_characters>none</remove_special_characters></field>
      <field><in_stream_name>unit_price</in_stream_name><out_stream_name/><trim_type>both</trim_type><lower_upper>none</lower_upper><padding_type>none</padding_type><pad_char/><pad_len/><init_cap>no</init_cap><mask_xml>none</mask_xml><digits>none</digits><remove_special_characters>none</remove_special_characters></field>
      <field><in_stream_name>customer_id</in_stream_name><out_stream_name/><trim_type>both</trim_type><lower_upper>none</lower_upper><padding_type>none</padding_type><pad_char/><pad_len/><init_cap>no</init_cap><mask_xml>none</mask_xml><digits>none</digits><remove_special_characters>none</remove_special_characters></field>
      <field><in_stream_name>country</in_stream_name><out_stream_name/><trim_type>both</trim_type><lower_upper>none</lower_upper><padding_type>none</padding_type><pad_char/><pad_len/><init_cap>no</init_cap><mask_xml>none</mask_xml><digits>none</digits><remove_special_characters>none</remove_special_characters></field>
    </fields>
    <attributes/>
    <GUI><xloc>240</xloc><yloc>240</yloc></GUI>
  </transform>
  <transform>
    <name>Converter tipos</name>
    <type>SelectValues</type>
    <description>Conversoes invalidas seguem pelo error hop com os campos brutos preservados.</description>
    <distribute>N</distribute><custom_distribution/><copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <fields>
      <select_unspecified>Y</select_unspecified>
      <meta><name>quantity</name><rename>quantity</rename><type>Integer</type><length>-2</length><precision>0</precision><conversion_mask>0</conversion_mask><date_format_lenient>false</date_format_lenient><date_format_locale/><date_format_timezone/><lenient_string_to_number>false</lenient_string_to_number><encoding/><decimal_symbol>.</decimal_symbol><grouping_symbol/><currency_symbol/><storage_type/></meta>
      <meta><name>invoice_date</name><rename>invoice_date</rename><type>Date</type><length>-2</length><precision>-2</precision><conversion_mask>yyyy-MM-dd HH:mm:ss</conversion_mask><date_format_lenient>false</date_format_lenient><date_format_locale/><date_format_timezone/><lenient_string_to_number>false</lenient_string_to_number><encoding/><decimal_symbol/><grouping_symbol/><currency_symbol/><storage_type/></meta>
      <meta><name>unit_price</name><rename>unit_price</rename><type>BigNumber</type><length>18</length><precision>4</precision><conversion_mask>0.####</conversion_mask><date_format_lenient>false</date_format_lenient><date_format_locale/><date_format_timezone/><lenient_string_to_number>false</lenient_string_to_number><encoding/><decimal_symbol>.</decimal_symbol><grouping_symbol/><currency_symbol/><storage_type/></meta>
      <meta><name>customer_id</name><rename>customer_id</rename><type>Integer</type><length>-2</length><precision>0</precision><conversion_mask>0</conversion_mask><date_format_lenient>false</date_format_lenient><date_format_locale/><date_format_timezone/><lenient_string_to_number>false</lenient_string_to_number><encoding/><decimal_symbol>.</decimal_symbol><grouping_symbol/><currency_symbol/><storage_type/></meta>
    </fields>
    <attributes/>
    <GUI><xloc>416</xloc><yloc>240</yloc></GUI>
  </transform>
  <transform>
    <name>Marcar erro de conversao</name>
    <type>Constant</type>
    <description>Classifica todo erro de cast como ERRO_CONVERSAO_TIPO.</description>
    <distribute>Y</distribute><custom_distribution/><copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <fields><field><currency/><decimal/><format/><group/><length>100</length><name>motivo</name><nullif>ERRO_CONVERSAO_TIPO</nullif><precision>-1</precision><set_empty_string>N</set_empty_string><type>String</type></field></fields>
    <attributes/>
    <GUI><xloc>416</xloc><yloc>64</yloc></GUI>
  </transform>
  <transform>
    <name>Gravar rejeitados de conversao</name>
    <type>TableOutput</type>
    <description>O detalhe recebe a descricao tecnica produzida pelo error hop.</description>
    <distribute>Y</distribute><custom_distribution/><copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <commit>1000</commit><connection>OnlineRetailPostgreSQL</connection><schema>online_retail</schema><table>rejeitados</table><truncate>N</truncate><ignore_errors>N</ignore_errors><use_batch>Y</use_batch><specify_fields>Y</specify_fields><partitioning_enabled>N</partitioning_enabled><partitioning_daily>N</partitioning_daily><partitioning_monthly>N</partitioning_monthly><tablename_in_field>N</tablename_in_field><tablename_in_table>Y</tablename_in_table><return_keys>N</return_keys>
    <fields>
      <field><column_name>batch_id</column_name><stream_name>batch_id</stream_name></field><field><column_name>linha_seq</column_name><stream_name>linha_seq</stream_name></field><field><column_name>invoice_no</column_name><stream_name>invoice_no</stream_name></field><field><column_name>stock_code</column_name><stream_name>stock_code</stream_name></field><field><column_name>description</column_name><stream_name>description</stream_name></field><field><column_name>quantity_original</column_name><stream_name>quantity_original</stream_name></field><field><column_name>invoice_date_original</column_name><stream_name>invoice_date_original</stream_name></field><field><column_name>unit_price_original</column_name><stream_name>unit_price_original</stream_name></field><field><column_name>customer_id_original</column_name><stream_name>customer_id_original</stream_name></field><field><column_name>country_original</column_name><stream_name>country_original</stream_name></field><field><column_name>motivo</column_name><stream_name>motivo</stream_name></field><field><column_name>detalhe</column_name><stream_name>error_description</stream_name></field>
    </fields>
    <attributes/>
    <GUI><xloc>640</xloc><yloc>64</yloc></GUI>
  </transform>
  <transform>
    <name>Ordenar para deduplicacao</name>
    <type>SortRows</type>
    <description>As oito colunas brutas definem igualdade integral; linha_seq somente estabiliza qual ocorrencia e mantida.</description>
    <distribute>Y</distribute><custom_distribution/><copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <directory>${java.io.tmpdir}</directory><prefix>online_retail_dedup</prefix><sort_size>100000</sort_size><free_memory/><compress>N</compress><compress_variable/><unique_rows>N</unique_rows>
    <fields>
      <field><name>invoice_no</name><ascending>Y</ascending><case_sensitive>Y</case_sensitive><collator_enabled>N</collator_enabled><collator_strength>0</collator_strength><presorted>N</presorted></field>
      <field><name>stock_code</name><ascending>Y</ascending><case_sensitive>Y</case_sensitive><collator_enabled>N</collator_enabled><collator_strength>0</collator_strength><presorted>N</presorted></field>
      <field><name>description</name><ascending>Y</ascending><case_sensitive>Y</case_sensitive><collator_enabled>N</collator_enabled><collator_strength>0</collator_strength><presorted>N</presorted></field>
      <field><name>quantity_original</name><ascending>Y</ascending><case_sensitive>Y</case_sensitive><collator_enabled>N</collator_enabled><collator_strength>0</collator_strength><presorted>N</presorted></field>
      <field><name>invoice_date_original</name><ascending>Y</ascending><case_sensitive>Y</case_sensitive><collator_enabled>N</collator_enabled><collator_strength>0</collator_strength><presorted>N</presorted></field>
      <field><name>unit_price_original</name><ascending>Y</ascending><case_sensitive>Y</case_sensitive><collator_enabled>N</collator_enabled><collator_strength>0</collator_strength><presorted>N</presorted></field>
      <field><name>customer_id_original</name><ascending>Y</ascending><case_sensitive>Y</case_sensitive><collator_enabled>N</collator_enabled><collator_strength>0</collator_strength><presorted>N</presorted></field>
      <field><name>country_original</name><ascending>Y</ascending><case_sensitive>Y</case_sensitive><collator_enabled>N</collator_enabled><collator_strength>0</collator_strength><presorted>N</presorted></field>
      <field><name>linha_seq</name><ascending>Y</ascending><case_sensitive>N</case_sensitive><collator_enabled>N</collator_enabled><collator_strength>0</collator_strength><presorted>N</presorted></field>
    </fields>
    <attributes/>
    <GUI><xloc>608</xloc><yloc>240</yloc></GUI>
  </transform>
  <transform>
    <name>Remover duplicatas integrais</name>
    <type>Unique</type>
    <description>Rejeita somente ocorrencias posteriores com os oito valores brutos identicos.</description>
    <distribute>Y</distribute><custom_distribution/><copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <count_rows>N</count_rows><count_field/><reject_duplicate_row>Y</reject_duplicate_row><error_description>Registro integralmente duplicado</error_description>
    <fields>
      <field><name>invoice_no</name><case_insensitive>N</case_insensitive></field><field><name>stock_code</name><case_insensitive>N</case_insensitive></field><field><name>description</name><case_insensitive>N</case_insensitive></field><field><name>quantity_original</name><case_insensitive>N</case_insensitive></field><field><name>invoice_date_original</name><case_insensitive>N</case_insensitive></field><field><name>unit_price_original</name><case_insensitive>N</case_insensitive></field><field><name>customer_id_original</name><case_insensitive>N</case_insensitive></field><field><name>country_original</name><case_insensitive>N</case_insensitive></field>
    </fields>
    <attributes/>
    <GUI><xloc>816</xloc><yloc>240</yloc></GUI>
  </transform>
  <transform>
    <name>Marcar duplicata</name>
    <type>Constant</type>
    <description>Classifica a ocorrencia descartada sem alterar a primeira linha legitima.</description>
    <distribute>Y</distribute><custom_distribution/><copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <fields>
      <field><currency/><decimal/><format/><group/><length>100</length><name>motivo</name><nullif>DUPLICATA_INTEGRAL</nullif><precision>-1</precision><set_empty_string>N</set_empty_string><type>String</type></field>
      <field><currency/><decimal/><format/><group/><length>-1</length><name>detalhe</name><nullif>Os oito campos da fonte repetem integralmente uma ocorrencia anterior do lote.</nullif><precision>-1</precision><set_empty_string>N</set_empty_string><type>String</type></field>
    </fields>
    <attributes/>
    <GUI><xloc>816</xloc><yloc>64</yloc></GUI>
  </transform>
  <transform>
    <name>Gravar duplicatas rejeitadas</name>
    <type>TableOutput</type>
    <description/>
    <distribute>Y</distribute><custom_distribution/><copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <commit>1000</commit><connection>OnlineRetailPostgreSQL</connection><schema>online_retail</schema><table>rejeitados</table><truncate>N</truncate><ignore_errors>N</ignore_errors><use_batch>Y</use_batch><specify_fields>Y</specify_fields><partitioning_enabled>N</partitioning_enabled><partitioning_daily>N</partitioning_daily><partitioning_monthly>N</partitioning_monthly><tablename_in_field>N</tablename_in_field><tablename_in_table>Y</tablename_in_table><return_keys>N</return_keys>
    <fields>
      <field><column_name>batch_id</column_name><stream_name>batch_id</stream_name></field><field><column_name>linha_seq</column_name><stream_name>linha_seq</stream_name></field><field><column_name>invoice_no</column_name><stream_name>invoice_no</stream_name></field><field><column_name>stock_code</column_name><stream_name>stock_code</stream_name></field><field><column_name>description</column_name><stream_name>description</stream_name></field><field><column_name>quantity_original</column_name><stream_name>quantity_original</stream_name></field><field><column_name>invoice_date_original</column_name><stream_name>invoice_date_original</stream_name></field><field><column_name>unit_price_original</column_name><stream_name>unit_price_original</stream_name></field><field><column_name>customer_id_original</column_name><stream_name>customer_id_original</stream_name></field><field><column_name>country_original</column_name><stream_name>country_original</stream_name></field><field><column_name>motivo</column_name><stream_name>motivo</stream_name></field><field><column_name>detalhe</column_name><stream_name>detalhe</stream_name></field>
    </fields>
    <attributes/>
    <GUI><xloc>1040</xloc><yloc>64</yloc></GUI>
  </transform>
  <transform>
    <name>Aplicar regras de negocio</name>
    <type>ScriptValueMod</type>
    <description>Cancelamentos com quantidade negativa sao mantidos; preco nao positivo sempre e rejeitado.</description>
    <distribute>Y</distribute><custom_distribution/><copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <optimizationLevel>9</optimizationLevel>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Regras Online Retail</jsScript_name>
        <jsScript_script>var invoiceText = invoice_no == null ? "" : String(invoice_no);
var cancelamento = invoiceText.toUpperCase().indexOf("C") === 0;

var description_tratada = (description == null || String(description).trim().length === 0)
  ? "SEM_DESCRICAO" : String(description);
var country_tratado = (country == null || String(country).trim().length === 0)
  ? "NAO_INFORMADO" : String(country);

var motivo = null;
var detalhe = null;
var quantidadeNula = quantity == null;
var precoNulo = unit_price == null;

if (quantidadeNula || (!cancelamento &amp;&amp; Number(quantity) &lt;= 0)) {
  motivo = "QUANTIDADE_INVALIDA";
  detalhe = "Quantidade nula, zero ou negativa em uma venda que nao e cancelamento.";
} else if (precoNulo || Number(unit_price) &lt;= 0) {
  motivo = "PRECO_UNITARIO_INVALIDO";
  detalhe = "Preco unitario nulo, zero ou negativo.";
}</jsScript_script>
      </jsScript>
    </jsScripts>
    <fields>
      <field><name>cancelamento</name><rename>cancelamento</rename><type>Boolean</type><length>-1</length><precision>-1</precision><replace>N</replace></field>
      <field><name>description_tratada</name><rename>description_tratada</rename><type>String</type><length>-1</length><precision>-1</precision><replace>N</replace></field>
      <field><name>country_tratado</name><rename>country_tratado</rename><type>String</type><length>100</length><precision>-1</precision><replace>N</replace></field>
      <field><name>motivo</name><rename>motivo</rename><type>String</type><length>100</length><precision>-1</precision><replace>N</replace></field>
      <field><name>detalhe</name><rename>detalhe</rename><type>String</type><length>-1</length><precision>-1</precision><replace>N</replace></field>
    </fields>
    <attributes/>
    <GUI><xloc>1024</xloc><yloc>240</yloc></GUI>
  </transform>
  <transform>
    <name>Calcular valor total</name>
    <type>Janino</type>
    <description>valor_total = unit_price * quantity, em BigDecimal exato. Nao usa o transform Calculator de proposito: a multiplicacao BigNumber do Calculator aplica um MathContext derivado da precisao dos operandos e arredonda o resultado para poucos digitos significativos (9 x 15,00 viraria 140,00). O sinal da quantidade e preservado, entao cancelamentos ficam negativos.</description>
    <distribute>Y</distribute><custom_distribution/><copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <formula>
      <field_name>valor_total</field_name>
      <formula_string>unit_price.multiply(java.math.BigDecimal.valueOf(quantity.longValue()))</formula_string>
      <value_type>BigNumber</value_type>
      <value_length>20</value_length>
      <value_precision>4</value_precision>
      <replace_field/>
    </formula>
    <java_target_version>21</java_target_version>
    <attributes/>
    <GUI><xloc>1648</xloc><yloc>176</yloc></GUI>
  </transform>
  <transform>
    <name>Separar validos e invalidos</name>
    <type>FilterRows</type>
    <description>True: motivo IS NULL (valido). False: rejeitado por regra de negocio.</description>
    <distribute>Y</distribute><custom_distribution/><copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <send_true_to>Calcular valor total</send_true_to><send_false_to>Gravar rejeitados por regra</send_false_to>
    <compare><condition><conditions></conditions><function>IS NULL</function><leftvalue>motivo</leftvalue><negated>N</negated><operator>-</operator></condition></compare>
    <attributes/>
    <GUI><xloc>1440</xloc><yloc>240</yloc></GUI>
  </transform>
  <transform>
    <name>Gravar validos</name>
    <type>TableOutput</type>
    <description>Substitui a area de trabalho do lote; a fato sera carregada por pipeline posterior.</description>
