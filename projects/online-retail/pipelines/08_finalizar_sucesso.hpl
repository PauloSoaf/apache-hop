<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>08_finalizar_sucesso</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Reconcilia as contagens do lote e encerra o log com SUCCESS.</description>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <pipeline_status>0</pipeline_status>
    <parameters/>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>Codex</created_user>
    <created_date>2026/08/25 00:00:00.000</created_date>
    <modified_user>Codex</modified_user>
    <modified_date>2026/08/25 00:00:00.000</modified_date>
    <key_for_session_key/>
    <is_key_private>N</is_key_private>
  </info>
  <order>
    <hop>
      <from>Contar resultados do lote</from>
      <to>Marcar log SUCCESS</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>Contar resultados do lote</name>
    <type>TableInput</type>
    <description>Conta staging, work válido, rejeitados, duplicatas e fato persistida.</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>OnlineRetailPostgreSQL</connection>
    <sql>SELECT '${BATCH_ID}'::varchar(64) AS batch_id,
       (SELECT COUNT(*)::bigint FROM online_retail.stg_online_retail s WHERE s.batch_id = '${BATCH_ID}') AS linhas_staging,
       (SELECT COUNT(*)::bigint FROM online_retail.wrk_online_retail_validos w WHERE w.batch_id = '${BATCH_ID}') AS linhas_validas,
       (SELECT COUNT(*)::bigint FROM online_retail.rejeitados r WHERE r.batch_id = '${BATCH_ID}') AS linhas_rejeitadas,
       (SELECT COUNT(*)::bigint FROM online_retail.rejeitados r WHERE r.batch_id = '${BATCH_ID}' AND r.motivo = 'DUPLICATA_INTEGRAL') AS duplicatas_removidas,
       (SELECT COUNT(*)::bigint FROM online_retail.fato_venda f WHERE f.batch_id = '${BATCH_ID}') AS linhas_fato,
       CURRENT_TIMESTAMP AS fim_execucao,
       'SUCCESS'::varchar(16) AS status,
       NULL::text AS mensagem_erro;</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>Y</variables_active>
    <attributes/>
    <GUI>
      <xloc>128</xloc>
      <yloc>144</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Marcar log SUCCESS</name>
    <type>InsertUpdate</type>
    <description>Atualiza a auditoria do lote concluído.</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>OnlineRetailPostgreSQL</connection>
    <commit>1</commit>
    <update_bypassed>N</update_bypassed>
    <lookup>
      <schema>online_retail</schema>
      <table>log_execucao</table>
      <key><name>batch_id</name><field>batch_id</field><condition>=</condition><name2/></key>
      <value><name>batch_id</name><rename>batch_id</rename><update>N</update></value>
      <value><name>linhas_staging</name><rename>linhas_staging</rename><update>Y</update></value>
      <value><name>linhas_validas</name><rename>linhas_validas</rename><update>Y</update></value>
      <value><name>linhas_rejeitadas</name><rename>linhas_rejeitadas</rename><update>Y</update></value>
      <value><name>duplicatas_removidas</name><rename>duplicatas_removidas</rename><update>Y</update></value>
      <value><name>linhas_fato</name><rename>linhas_fato</rename><update>Y</update></value>
      <value><name>fim_execucao</name><rename>fim_execucao</rename><update>Y</update></value>
      <value><name>status</name><rename>status</rename><update>Y</update></value>
      <value><name>mensagem_erro</name><rename>mensagem_erro</rename><update>Y</update></value>
    </lookup>
    <attributes/>
    <GUI>
      <xloc>448</xloc>
      <yloc>144</yloc>
    </GUI>
  </transform>
  <transform_error_handling/>
  <attributes/>
</pipeline>
