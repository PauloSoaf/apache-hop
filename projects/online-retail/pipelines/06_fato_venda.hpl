<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>06_fato_venda</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Resolve as chaves substitutas e carrega a fato de forma idempotente.</description>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <pipeline_status>0</pipeline_status>
    <parameters/>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>Codex</created_user>
    <created_date>2026/08/25 00:00:00.000</created_date>
    <modified_user>Codex</modified_user>
    <modified_date>2026/08/25 00:00:00.000</modified_date>
    <key_for_session_key/>
    <is_key_private>N</is_key_private>
  </info>
  <order>
    <hop>
      <from>Resolver chaves dimensionais</from>
      <to>Upsert fato_venda</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>Resolver chaves dimensionais</name>
    <type>TableInput</type>
    <description>Une apenas os registros válidos do lote às três dimensões persistidas.</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>OnlineRetailPostgreSQL</connection>
    <sql>SELECT w.invoice_no,
       w.stock_code,
       w.linha_seq,
       p.produto_sk,
       c.pais_sk,
       t.tempo_sk,
       w.customer_id,
       w.quantity,
       w.unit_price,
       w.valor_total,
       w.cancelamento,
       w.invoice_date,
       w.batch_id
  FROM online_retail.wrk_online_retail_validos w
  JOIN online_retail.dim_produto p
    ON p.stock_code = w.stock_code
  JOIN online_retail.dim_pais c
    ON c.country = w.country
  JOIN online_retail.dim_tempo t
    ON t.data = w.invoice_date::date
 WHERE w.batch_id = '${BATCH_ID}'
 ORDER BY w.invoice_no, w.stock_code, w.linha_seq;</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>Y</variables_active>
    <attributes/>
    <GUI>
      <xloc>128</xloc>
      <yloc>144</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Upsert fato_venda</name>
    <type>InsertUpdate</type>
    <description>Usa invoice_no + stock_code + linha_seq como chave natural.</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>OnlineRetailPostgreSQL</connection>
    <commit>1000</commit>
    <update_bypassed>N</update_bypassed>
    <lookup>
      <schema>online_retail</schema>
      <table>fato_venda</table>
      <key><name>invoice_no</name><field>invoice_no</field><condition>=</condition><name2/></key>
      <key><name>stock_code</name><field>stock_code</field><condition>=</condition><name2/></key>
      <key><name>linha_seq</name><field>linha_seq</field><condition>=</condition><name2/></key>
      <value><name>invoice_no</name><rename>invoice_no</rename><update>N</update></value>
      <value><name>stock_code</name><rename>stock_code</rename><update>N</update></value>
      <value><name>linha_seq</name><rename>linha_seq</rename><update>N</update></value>
      <value><name>produto_sk</name><rename>produto_sk</rename><update>Y</update></value>
      <value><name>pais_sk</name><rename>pais_sk</rename><update>Y</update></value>
      <value><name>tempo_sk</name><rename>tempo_sk</rename><update>Y</update></value>
      <value><name>customer_id</name><rename>customer_id</rename><update>Y</update></value>
      <value><name>quantity</name><rename>quantity</rename><update>Y</update></value>
      <value><name>unit_price</name><rename>unit_price</rename><update>Y</update></value>
      <value><name>valor_total</name><rename>valor_total</rename><update>Y</update></value>
      <value><name>cancelamento</name><rename>cancelamento</rename><update>Y</update></value>
      <value><name>invoice_date</name><rename>invoice_date</rename><update>Y</update></value>
      <value><name>batch_id</name><rename>batch_id</rename><update>Y</update></value>
    </lookup>
    <attributes/>
    <GUI>
      <xloc>448</xloc>
      <yloc>144</yloc>
    </GUI>
  </transform>
  <transform_error_handling/>
  <attributes/>
</pipeline>
