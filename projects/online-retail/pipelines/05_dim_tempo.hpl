<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>05_dim_tempo</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Carrega as datas com movimento por upsert na dimensão de tempo.</description>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <pipeline_status>0</pipeline_status>
    <parameters/>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>Codex</created_user>
    <created_date>2026/08/25 00:00:00.000</created_date>
    <modified_user>Codex</modified_user>
    <modified_date>2026/08/25 00:00:00.000</modified_date>
    <key_for_session_key/>
    <is_key_private>N</is_key_private>
  </info>
  <order>
    <hop>
      <from>Derivar datas do lote</from>
      <to>Upsert dim_tempo</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>Derivar datas do lote</name>
    <type>TableInput</type>
    <description>Deriva atributos calendário para cada data distinta do work.</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>OnlineRetailPostgreSQL</connection>
    <sql>WITH datas AS (
  SELECT DISTINCT w.invoice_date::date AS data
    FROM online_retail.wrk_online_retail_validos w
   WHERE w.batch_id = '${BATCH_ID}'
)
SELECT d.data,
       EXTRACT(DAY FROM d.data)::smallint AS dia,
       EXTRACT(MONTH FROM d.data)::smallint AS mes,
       CASE EXTRACT(MONTH FROM d.data)::integer
         WHEN 1 THEN 'Janeiro' WHEN 2 THEN 'Fevereiro'
         WHEN 3 THEN 'Março' WHEN 4 THEN 'Abril'
         WHEN 5 THEN 'Maio' WHEN 6 THEN 'Junho'
         WHEN 7 THEN 'Julho' WHEN 8 THEN 'Agosto'
         WHEN 9 THEN 'Setembro' WHEN 10 THEN 'Outubro'
         WHEN 11 THEN 'Novembro' ELSE 'Dezembro'
       END::varchar(20) AS nome_mes,
       EXTRACT(QUARTER FROM d.data)::smallint AS trimestre,
       EXTRACT(YEAR FROM d.data)::smallint AS ano,
       CASE EXTRACT(ISODOW FROM d.data)::integer
         WHEN 1 THEN 'Segunda-feira' WHEN 2 THEN 'Terça-feira'
         WHEN 3 THEN 'Quarta-feira' WHEN 4 THEN 'Quinta-feira'
         WHEN 5 THEN 'Sexta-feira' WHEN 6 THEN 'Sábado'
         ELSE 'Domingo'
       END::varchar(20) AS dia_semana
  FROM datas d
 ORDER BY d.data;</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>Y</variables_active>
    <attributes/>
    <GUI>
      <xloc>144</xloc>
      <yloc>144</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Upsert dim_tempo</name>
    <type>InsertUpdate</type>
    <description>Insere datas novas e mantém seus atributos calendário atualizados.</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>OnlineRetailPostgreSQL</connection>
    <commit>1000</commit>
    <update_bypassed>N</update_bypassed>
    <lookup>
      <schema>online_retail</schema>
      <table>dim_tempo</table>
      <key>
        <name>data</name>
        <field>data</field>
        <condition>=</condition>
        <name2/>
      </key>
      <value>
        <name>data</name>
        <rename>data</rename>
        <update>N</update>
      </value>
      <value><name>dia</name><rename>dia</rename><update>Y</update></value>
      <value><name>mes</name><rename>mes</rename><update>Y</update></value>
      <value><name>nome_mes</name><rename>nome_mes</rename><update>Y</update></value>
      <value><name>trimestre</name><rename>trimestre</rename><update>Y</update></value>
      <value><name>ano</name><rename>ano</rename><update>Y</update></value>
      <value><name>dia_semana</name><rename>dia_semana</rename><update>Y</update></value>
    </lookup>
    <attributes/>
    <GUI>
      <xloc>432</xloc>
      <yloc>144</yloc>
    </GUI>
  </transform>
  <transform_error_handling/>
  <attributes/>
</pipeline>
