<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>01_ingestao_online_retail</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Le o arquivo Online Retail e carrega uma staging textual, rastreavel por batch e linha da planilha.</description>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <parameters/>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>Codex</created_user>
    <created_date>2026/08/25 00:00:00.000</created_date>
    <modified_user>Codex</modified_user>
    <modified_date>2026/08/25 00:00:00.000</modified_date>
  </info>
  <notepads/>
  <order>
    <hop><from>Ler Online Retail</from><to>Normalizar nomes</to><enabled>Y</enabled></hop>
    <hop><from>Normalizar nomes</from><to>Converter para texto canonico</to><enabled>Y</enabled></hop>
    <hop><from>Converter para texto canonico</from><to>Remover espacos externos</to><enabled>Y</enabled></hop>
    <hop><from>Remover espacos externos</from><to>Calcular hash do registro</to><enabled>Y</enabled></hop>
    <hop><from>Calcular hash do registro</from><to>Adicionar batch</to><enabled>Y</enabled></hop>
    <hop><from>Adicionar batch</from><to>Carregar staging</to><enabled>Y</enabled></hop>
    <hop><from>Adicionar batch</from><to>Contar linhas recebidas</to><enabled>Y</enabled></hop>
    <hop><from>Contar linhas recebidas</from><to>Registrar linhas de origem</to><enabled>Y</enabled></hop>
  </order>
  <transform>
    <name>Ler Online Retail</name>
    <type>ExcelInput</type>
    <description>Le uma unica copia, preservando linha_seq como numero deterministico da linha na planilha.</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <file>
      <name>${ONLINE_RETAIL_FILE}</name>
      <filemask/>
      <exclude_filemask/>
      <file_required>Y</file_required>
      <include_subfolders>N</include_subfolders>
    </file>
    <filefield/>
    <sheets>
      <sheet>
        <name>Online Retail</name>
        <startrow>0</startrow>
        <startcol>0</startcol>
        <is_regex>N</is_regex>
      </sheet>
    </sheets>
    <sheetfield/>
    <header>Y</header>
    <schema_definition/>
    <ignore_fields>N</ignore_fields>
    <stoponempty>N</stoponempty>
    <noempty>Y</noempty>
    <rownumfield/>
    <sheetrownumfield>linha_seq</sheetrownumfield>
    <limit>0</limit>
    <fields>
      <field><name>InvoiceNo</name><type>String</type><length>-1</length><precision>-1</precision><trim_type>none</trim_type><format>#</format><currency/><decimal>.</decimal><group/><repeat>N</repeat></field>
      <field><name>StockCode</name><type>String</type><length>-1</length><precision>-1</precision><trim_type>none</trim_type><format>#</format><currency/><decimal>.</decimal><group/><repeat>N</repeat></field>
      <field><name>Description</name><type>String</type><length>-1</length><precision>-1</precision><trim_type>none</trim_type><format/><currency/><decimal/><group/><repeat>N</repeat></field>
      <field><name>Quantity</name><type>Integer</type><length>-1</length><precision>0</precision><trim_type>none</trim_type><format>0</format><currency/><decimal>.</decimal><group/><repeat>N</repeat></field>
      <field><name>InvoiceDate</name><type>Date</type><length>-1</length><precision>-1</precision><trim_type>none</trim_type><format>yyyy-MM-dd HH:mm:ss</format><currency/><decimal/><group/><repeat>N</repeat></field>
      <field><name>UnitPrice</name><type>BigNumber</type><length>-1</length><precision>4</precision><trim_type>none</trim_type><format>0.####</format><currency/><decimal>.</decimal><group/><repeat>N</repeat></field>
      <field><name>CustomerID</name><type>Integer</type><length>-1</length><precision>0</precision><trim_type>none</trim_type><format>0</format><currency/><decimal>.</decimal><group/><repeat>N</repeat></field>
      <field><name>Country</name><type>String</type><length>-1</length><precision>-1</precision><trim_type>none</trim_type><format/><currency/><decimal/><group/><repeat>N</repeat></field>
    </fields>
    <strict_types>N</strict_types>
    <error_ignored>N</error_ignored>
    <error_line_skipped>N</error_line_skipped>
    <bad_line_files_destination_directory/>
    <bad_line_files_extension>warning</bad_line_files_extension>
    <error_line_files_destination_directory/>
    <error_line_files_extension>error</error_line_files_extension>
    <line_number_files_destination_directory/>
    <line_number_files_extension>line</line_number_files_extension>
    <accept_filenames>N</accept_filenames>
    <accept_field/>
    <accept_transform_name/>
    <encoding>UTF-8</encoding>
    <add_to_result_filenames>Y</add_to_result_filenames>
    <shortFileFieldName/>
    <pathFieldName/>
    <hiddenFieldName/>
    <lastModificationTimeFieldName/>
    <uriNameFieldName/>
    <rootUriNameFieldName/>
    <extensionFieldName/>
    <sizeFieldName/>
    <spreadsheet_type>SAX_POI</spreadsheet_type>
    <attributes/>
    <GUI><xloc>80</xloc><yloc>160</yloc></GUI>
  </transform>
  <transform>
    <name>Normalizar nomes</name>
    <type>SelectValues</type>
    <description>Normaliza cabecalhos e mantem somente os oito campos da fonte mais linha_seq.</description>
    <distribute>Y</distribute><custom_distribution/><copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <fields>
      <field><name>linha_seq</name><rename>linha_seq</rename><length>-2</length><precision>-2</precision></field>
      <field><name>InvoiceNo</name><rename>invoice_no</rename><length>-2</length><precision>-2</precision></field>
      <field><name>StockCode</name><rename>stock_code</rename><length>-2</length><precision>-2</precision></field>
      <field><name>Description</name><rename>description</rename><length>-2</length><precision>-2</precision></field>
      <field><name>Quantity</name><rename>quantity_original</rename><length>-2</length><precision>-2</precision></field>
      <field><name>InvoiceDate</name><rename>invoice_date_original</rename><length>-2</length><precision>-2</precision></field>
      <field><name>UnitPrice</name><rename>unit_price_original</rename><length>-2</length><precision>-2</precision></field>
      <field><name>CustomerID</name><rename>customer_id_original</rename><length>-2</length><precision>-2</precision></field>
      <field><name>Country</name><rename>country_original</rename><length>-2</length><precision>-2</precision></field>
      <select_unspecified>N</select_unspecified>
    </fields>
    <attributes/>
    <GUI><xloc>272</xloc><yloc>160</yloc></GUI>
  </transform>
  <transform>
    <name>Converter para texto canonico</name>
    <type>SelectValues</type>
    <description>Converte numericos e data para representacao textual deterministica antes da staging.</description>
    <distribute>Y</distribute><custom_distribution/><copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <fields>
      <select_unspecified>Y</select_unspecified>
      <meta><name>quantity_original</name><rename>quantity_original</rename><type>String</type><length>-2</length><precision>-2</precision><conversion_mask>0</conversion_mask><date_format_lenient>false</date_format_lenient><date_format_locale/><date_format_timezone/><lenient_string_to_number>false</lenient_string_to_number><encoding/><decimal_symbol>.</decimal_symbol><grouping_symbol/><currency_symbol/><storage_type/></meta>
      <meta><name>invoice_date_original</name><rename>invoice_date_original</rename><type>String</type><length>-2</length><precision>-2</precision><conversion_mask>yyyy-MM-dd HH:mm:ss</conversion_mask><date_format_lenient>false</date_format_lenient><date_format_locale/><date_format_timezone/><lenient_string_to_number>false</lenient_string_to_number><encoding/><decimal_symbol/><grouping_symbol/><currency_symbol/><storage_type/></meta>
      <meta><name>unit_price_original</name><rename>unit_price_original</rename><type>String</type><length>-2</length><precision>-2</precision><conversion_mask>0.####</conversion_mask><date_format_lenient>false</date_format_lenient><date_format_locale/><date_format_timezone/><lenient_string_to_number>false</lenient_string_to_number><encoding/><decimal_symbol>.</decimal_symbol><grouping_symbol/><currency_symbol/><storage_type/></meta>
      <meta><name>customer_id_original</name><rename>customer_id_original</rename><type>String</type><length>-2</length><precision>-2</precision><conversion_mask>0</conversion_mask><date_format_lenient>false</date_format_lenient><date_format_locale/><date_format_timezone/><lenient_string_to_number>false</lenient_string_to_number><encoding/><decimal_symbol>.</decimal_symbol><grouping_symbol/><currency_symbol/><storage_type/></meta>
    </fields>
    <attributes/>
    <GUI><xloc>480</xloc><yloc>160</yloc></GUI>
  </transform>
  <transform>
    <name>Remover espacos externos</name>
    <type>StringOperations</type>
    <description>Aplica trim sem alterar caixa ou caracteres internos.</description>
    <distribute>Y</distribute><custom_distribution/><copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <fields>
      <field><in_stream_name>invoice_no</in_stream_name><out_stream_name/><trim_type>both</trim_type><lower_upper>none</lower_upper><padding_type>none</padding_type><pad_char/><pad_len/><init_cap>no</init_cap><mask_xml>none</mask_xml><digits>none</digits><remove_special_characters>none</remove_special_characters></field>
      <field><in_stream_name>stock_code</in_stream_name><out_stream_name/><trim_type>both</trim_type><lower_upper>none</lower_upper><padding_type>none</padding_type><pad_char/><pad_len/><init_cap>no</init_cap><mask_xml>none</mask_xml><digits>none</digits><remove_special_characters>none</remove_special_characters></field>
      <field><in_stream_name>description</in_stream_name><out_stream_name/><trim_type>both</trim_type><lower_upper>none</lower_upper><padding_type>none</padding_type><pad_char/><pad_len/><init_cap>no</init_cap><mask_xml>none</mask_xml><digits>none</digits><remove_special_characters>none</remove_special_characters></field>
      <field><in_stream_name>quantity_original</in_stream_name><out_stream_name/><trim_type>both</trim_type><lower_upper>none</lower_upper><padding_type>none</padding_type><pad_char/><pad_len/><init_cap>no</init_cap><mask_xml>none</mask_xml><digits>none</digits><remove_special_characters>none</remove_special_characters></field>
      <field><in_stream_name>invoice_date_original</in_stream_name><out_stream_name/><trim_type>both</trim_type><lower_upper>none</lower_upper><padding_type>none</padding_type><pad_char/><pad_len/><init_cap>no</init_cap><mask_xml>none</mask_xml><digits>none</digits><remove_special_characters>none</remove_special_characters></field>
      <field><in_stream_name>unit_price_original</in_stream_name><out_stream_name/><trim_type>both</trim_type><lower_upper>none</lower_upper><padding_type>none</padding_type><pad_char/><pad_len/><init_cap>no</init_cap><mask_xml>none</mask_xml><digits>none</digits><remove_special_characters>none</remove_special_characters></field>
      <field><in_stream_name>customer_id_original</in_stream_name><out_stream_name/><trim_type>both</trim_type><lower_upper>none</lower_upper><padding_type>none</padding_type><pad_char/><pad_len/><init_cap>no</init_cap><mask_xml>none</mask_xml><digits>none</digits><remove_special_characters>none</remove_special_characters></field>
      <field><in_stream_name>country_original</in_stream_name><out_stream_name/><trim_type>both</trim_type><lower_upper>none</lower_upper><padding_type>none</padding_type><pad_char/><pad_len/><init_cap>no</init_cap><mask_xml>none</mask_xml><digits>none</digits><remove_special_characters>none</remove_special_characters></field>
    </fields>
    <attributes/>
    <GUI><xloc>688</xloc><yloc>160</yloc></GUI>
  </transform>
  <transform>
    <name>Calcular hash do registro</name>
    <type>CheckSum</type>
    <description>SHA-256 dos oito campos da fonte. Serve de trilha de auditoria e permite conferir por SQL as duplicatas integrais que o pipeline 02 remove.</description>
    <distribute>Y</distribute><custom_distribution/><copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <checksumtype>SHA-256</checksumtype>
    <resultfieldName>registro_hash</resultfieldName>
    <resultType>hexadecimal</resultType>
    <fields>
      <field><name>invoice_no</name></field>
      <field><name>stock_code</name></field>
      <field><name>description</name></field>
      <field><name>quantity_original</name></field>
      <field><name>invoice_date_original</name></field>
      <field><name>unit_price_original</name></field>
      <field><name>customer_id_original</name></field>
      <field><name>country_original</name></field>
    </fields>
    <attributes/>
    <GUI><xloc>896</xloc><yloc>160</yloc></GUI>
  </transform>
  <transform>
    <name>Adicionar batch</name>
    <type>GetVariable</type>
    <description>Le a variavel BATCH_ID publicada pelo workflow e anexa o identificador do lote a cada linha.</description>
    <distribute>N</distribute><custom_distribution/><copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <fields>
      <field>
        <name>batch_id</name>
        <variable>${BATCH_ID}</variable>
        <type>String</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
        <length>64</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
    </fields>
    <attributes/>
    <GUI><xloc>1104</xloc><yloc>160</yloc></GUI>
  </transform>
  <transform>
    <name>Carregar staging</name>
    <type>TableOutput</type>
    <description>Trunca a staging e insere o lote atual; campos tecnicos restantes usam defaults do banco.</description>
    <distribute>Y</distribute><custom_distribution/><copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <commit>5000</commit><connection>OnlineRetailPostgreSQL</connection><schema>online_retail</schema><table>stg_online_retail</table>
    <truncate>Y</truncate><ignore_errors>N</ignore_errors><use_batch>Y</use_batch><specify_fields>Y</specify_fields>
    <partitioning_enabled>N</partitioning_enabled><partitioning_daily>N</partitioning_daily><partitioning_monthly>N</partitioning_monthly>
    <tablename_in_field>N</tablename_in_field><tablename_in_table>Y</tablename_in_table><return_keys>N</return_keys>
    <fields>
      <field><column_name>batch_id</column_name><stream_name>batch_id</stream_name></field>
      <field><column_name>linha_seq</column_name><stream_name>linha_seq</stream_name></field>
      <field><column_name>invoice_no</column_name><stream_name>invoice_no</stream_name></field>
      <field><column_name>stock_code</column_name><stream_name>stock_code</stream_name></field>
      <field><column_name>description</column_name><stream_name>description</stream_name></field>
      <field><column_name>quantity_original</column_name><stream_name>quantity_original</stream_name></field>
      <field><column_name>invoice_date_original</column_name><stream_name>invoice_date_original</stream_name></field>
      <field><column_name>unit_price_original</column_name><stream_name>unit_price_original</stream_name></field>
      <field><column_name>customer_id_original</column_name><stream_name>customer_id_original</stream_name></field>
      <field><column_name>country_original</column_name><stream_name>country_original</stream_name></field>
      <field><column_name>registro_hash</column_name><stream_name>registro_hash</stream_name></field>
    </fields>
    <attributes/>
    <GUI><xloc>1312</xloc><yloc>96</yloc></GUI>
  </transform>
  <transform>
    <name>Contar linhas recebidas</name>
    <type>MemoryGroupBy</type>
    <description>Conta quantas linhas foram efetivamente lidas da planilha neste lote.</description>
    <distribute>Y</distribute><custom_distribution/><copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <give_back_row>N</give_back_row>
    <group>
      <field><name>batch_id</name></field>
    </group>
    <fields>
      <field>
        <aggregate>linhas_origem</aggregate>
        <subject>linha_seq</subject>
        <type>COUNT_ALL</type>
        <valuefield/>
      </field>
    </fields>
    <attributes/>
    <GUI><xloc>1312</xloc><yloc>240</yloc></GUI>
  </transform>
  <transform>
    <name>Registrar linhas de origem</name>
    <type>InsertUpdate</type>
    <description>Grava a quantidade recebida da fonte em log_execucao.linhas_origem.</description>
    <distribute>Y</distribute><custom_distribution/><copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <connection>OnlineRetailPostgreSQL</connection>
    <commit>1</commit>
    <update_bypassed>N</update_bypassed>
    <lookup>
      <schema>online_retail</schema>
      <table>log_execucao</table>
      <key><name>batch_id</name><field>batch_id</field><condition>=</condition><name2/></key>
      <value><name>batch_id</name><rename>batch_id</rename><update>N</update></value>
      <value><name>linhas_origem</name><rename>linhas_origem</rename><update>Y</update></value>
    </lookup>
    <attributes/>
    <GUI><xloc>1520</xloc><yloc>240</yloc></GUI>
  </transform>
  <transform_error_handling/>
  <attributes/>
</pipeline>
