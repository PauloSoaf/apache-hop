# Copie para .env e troque a senha antes de subir o ambiente:
#   cp .env.example .env && ./scripts/preparar-ambiente.sh
#
# Este arquivo e a UNICA fonte de verdade das credenciais:
#   - o docker compose le daqui (PostgreSQL);
#   - scripts/preparar-ambiente.sh gera a partir daqui o ambiente do Apache Hop
#     (projects/online-retail/online-retail-dev.json).
DB_HOST=online-retail-db
DB_PORT=5432
DB_NAME=online_retail
DB_USER=online_retail
DB_PASSWORD=change_me_local_only
ONLINE_RETAIL_FILE=/project/online-retail/data/online_retail.xlsx

# Conta administradora do Metabase (criada automaticamente por
# scripts/provisionar-metabase.py). E uma conta do Metabase, nao do PostgreSQL.
MB_ADMIN_EMAIL=admin@online-retail.local
MB_ADMIN_PASSWORD=OnlineRetail#2024
